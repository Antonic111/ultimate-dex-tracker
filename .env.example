# ==============================================================================
# Ultimate Dex Tracker - Environment Variables Template
# ==============================================================================

# Node Environment
NODE_ENV=development

# Database Connection (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/poketracker?retryWrites=true&w=majority

# Security Secrets (Generate strong random 64-char strings in production)
JWT_SECRET=your_super_secret_jwt_key_here
SESSION_SECRET=your_super_secret_session_key_here

# Application Base URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Transactional Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@ultimatedextracker.com
DISABLE_EMAILS=false

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Discord OAuth 2.0
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Profile Image Moderation (Sightengine)
SIGHTENGINE_API_USER=your_sightengine_api_user
SIGHTENGINE_API_SECRET=your_sightengine_api_secret

# ==============================================================================
# Paddle Billing v2 Configuration
# ==============================================================================

# Environment mode: 'sandbox' for testing or 'production' for live payments
PADDLE_ENVIRONMENT=production

# Server-side Secret API Key:
# - Sandbox: pdl_sdbx_apikey_...
# - Production: pdl_live_apikey_... (or generated in live Paddle Dashboard under Developer tools > Authentication)
PADDLE_API_KEY=pdl_live_apikey_your_live_api_key_here
PADDLE_SANDBOX_API_KEY=pdl_sdbx_apikey_your_sandbox_api_key_here

# Client-side Public Token:
# - Sandbox: test_...
# - Production: live_... (generated in live Paddle Dashboard under Developer tools > Authentication)
PADDLE_CLIENT_TOKEN=live_your_live_client_token_here

# Webhook Endpoint Secret Key:
# - Starts with pdl_ntfset_...
# - Generated in live Paddle Dashboard under Developer tools > Notifications
PADDLE_WEBHOOK_SECRET_KEY=pdl_ntfset_your_live_webhook_signing_secret_here

# Catalog Price ID for Monthly Premium Membership:
# - Sandbox: pri_01m13cbxvhcsbsrp6y8bm1pz21
# - Production: pri_... (generated in live catalog)
PADDLE_PREMIUM_MONTHLY_PRICE_ID=pri_your_live_monthly_price_id_here
