# ==============================================================================
# Ultimate Dex Tracker - Environment Variables Template
# ==============================================================================

# Node Environment
NODE_ENV=development

# Database Connection (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/poketracker?retryWrites=true&w=majority

# Security Secrets (Generate strong random 64-char strings in production)
JWT_SECRET=your_super_secret_jwt_key_here
SESSION_SECRET=your_super_secret_session_key_here

# Application Base URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Transactional Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@ultimatedextracker.com
DISABLE_EMAILS=false

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Discord OAuth 2.0
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Profile Image Moderation (Sightengine)
SIGHTENGINE_API_USER=your_sightengine_api_user
SIGHTENGINE_API_SECRET=your_sightengine_api_secret


# ==============================================================================
# Stripe Configuration (Managed Payments MoR / Billing)
# ==============================================================================

# Server-side Secret Key (Test mode: sk_test_... | Live mode: sk_live_...)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Client-side Publishable Key (Test mode: pk_test_... | Live mode: pk_live_...)
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Stripe Monthly Recurring Premium Membership Price ID:
# Sandbox: price_1UAQuoEK4DSuBBFULt1iH6ET ($4.99 USD/month)
STRIPE_PRICE_ID=price_1UAQuoEK4DSuBBFULt1iH6ET

# Webhook Endpoint Secret Key:
# Starts with whsec_... (Generated in Stripe Dashboard under Developers > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

